[Unit]
Description=AI Trading Bot Dashboard (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ai-trading-bot/trading-bot
ExecStart=%h/ai-trading-bot/trading-bot/venv/bin/streamlit run dashboard.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
