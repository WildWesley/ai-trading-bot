# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# Alpaca Paper Trading (get from alpaca.markets → Paper Trading → API Keys)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Anthropic Claude (get from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional overrides (defaults shown)
# TRADE_INTERVAL_SECONDS=300
# MAX_POSITION_SIZE_USD=1000.0
# WATCHLIST=AAPL,MSFT,NVDA   # comma-separated; overrides the 100-symbol default
